@@ -0,0 +1,22 @@
+$ErrorActionPreference = "Stop"
+Set-Location $PSScriptRoot
+
+if (!(Test-Path ".\nvngx.dll")) {
+    throw "nvngx.dll is missing"
+}
+if (!(Test-Path ".\nvngx_dlssnr.dll")) {
+    throw "Copy the same nvngx_dlssnr.dll that worked in NeuralScreen into this folder."
+}
+if (!(Test-Path ".\magpie-dlssnr-bridge-client.exe")) {
+    throw "magpie-dlssnr-bridge-client.exe is missing"
+}
+
+Remove-Item ".\magpie-dlssnr-worker-bridge.log" -ErrorAction SilentlyContinue
+
+& ".\magpie-dlssnr-bridge-client.exe"
+$rc = $LASTEXITCODE
+
+Write-Host ""
+Write-Host "client exit code:" $rc
+Write-Host "worker log:" (Join-Path $PSScriptRoot "magpie-dlssnr-worker-bridge.log")
+exit $rc

diff --git a/.github/workflows/dlssnr-worker-bridge.yml b/.github/workflows/dlssnr-worker-bridge.yml
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/.github/workflows/dlssnr-worker-bridge.yml
@@ -0,0 +1,88 @@
+name: DLSSNR worker bridge probe
+
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - '.github/workflows/dlssnr-worker-bridge.yml'
+      - 'tools/DLSSNR.WorkerBridge/**'
+
+jobs:
+  bridge-probe:
+    runs-on: windows-2025-vs2026
+
+    steps:
+      - name: Checkout Magpie
+        uses: actions/checkout@v7
+
+      - name: Checkout NVIDIA DLSS SDK
+        uses: actions/checkout@v7
+        with:
+          repository: NVIDIA/DLSS
+          path: dependencies/dlss-sdk
+          lfs: true
+
+      - name: Setup MSBuild
+        uses: microsoft/setup-msbuild@v2
+
+      - name: Build worker and D3D11 bridge client
+        shell: pwsh
+        run: |
+          $sdk = Join-Path $env:GITHUB_WORKSPACE "dependencies\dlss-sdk"
+          $out = Join-Path $env:GITHUB_WORKSPACE "worker-bridge"
+
+          New-Item -ItemType Directory -Force -Path $out | Out-Null
+
+          msbuild `
+            "$env:GITHUB_WORKSPACE\tools\DLSSNR.WorkerBridge\DLSSNR.WorkerBridge.vcxproj" `
+            /m /t:Rebuild `
+            /p:Configuration=Release `
+            /p:Platform=x64 `
+            /p:DLSSSdkDir="$sdk" `
+            /p:BridgeOutDir="$out\" `
+            /v:minimal
+
+          msbuild `
+            "$env:GITHUB_WORKSPACE\tools\DLSSNR.WorkerBridge\DLSSNR.BridgeClient.vcxproj" `
+            /m /t:Rebuild `
+            /p:Configuration=Release `
+            /p:Platform=x64 `
+            /p:BridgeOutDir="$out\" `
+            /v:minimal
+
+          if (!(Test-Path (Join-Path $out "nvngx.dll"))) {
+            throw "nvngx.dll was not built"
+          }
+          if (!(Test-Path (Join-Path $out "magpie-dlssnr-bridge-client.exe"))) {
+            throw "bridge client was not built"
+          }
+
+          Copy-Item `
+            "$env:GITHUB_WORKSPACE\tools\DLSSNR.WorkerBridge\run-bridge-probe.ps1" `
+            (Join-Path $out "run-bridge-probe.ps1")
+
+          @"
+          Magpie DLSSNR cross-process bridge probe
+
+          1. Copy the SAME nvngx_dlssnr.dll that worked in NeuralScreen
+             into this folder.
+          2. Run:
+               powershell -ExecutionPolicy Bypass -File .\run-bridge-probe.ps1
+          3. Send BOTH console output and magpie-dlssnr-worker-bridge.log.
+
+          What this tests:
+          D3D11 shared input/output texture
+              -> named NT handles
+              -> nvngx.dll D3D12 worker
+              -> Feature 18 Evaluate
+              -> shared D3D11 fence
+              -> D3D11 readback
+
+          It does not modify Magpie yet.
+          "@ | Set-Content -Encoding UTF8 (Join-Path $out "README.txt")
+
+      - name: Upload bridge probe
+        uses: actions/upload-artifact@v7
+        with:
+          name: Magpie-DLSSNR-worker-bridge-x64
+          path: worker-bridge
